{
    "name": "briizpay/module-paybybank",
    "description": "BriizPay pay by bank for Magento 2: UK Open Banking payments at checkout, settled to your bank account.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "1.2.0",
    "support": {
        "issues": "https://github.com/cavewebs/briizpay-magento/issues",
        "source": "https://github.com/cavewebs/briizpay-magento"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-checkout": "^100.4",
        "magento/module-config": "^101.2",
        "magento/module-payment": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1"
    },
    "require-dev": {
        "magento/magento-coding-standard": "^31.0",
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.11",
        "bitexpert/phpstan-magento": "^0.30"
    },
    "autoload": {
        "psr-4": {
            "BriizPay\\PayByBank\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BriizPay\\PayByBank\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "phpcs": "phpcs --standard=phpcs.xml .",
        "phpcbf": "phpcbf --standard=phpcs.xml .",
        "phpstan": "phpstan analyse --configuration phpstan.neon.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
