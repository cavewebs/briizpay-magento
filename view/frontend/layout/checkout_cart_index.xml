<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <!-- Shown on the basket page too when the basket already has
                                     BriizPay chosen, so the total there matches checkout. -->
                                <item name="briizpay_saving" xsi:type="array">
                                    <item name="component" xsi:type="string">BriizPay_PayByBank/js/view/cart/totals/pay-by-bank-discount</item>
                                    <item name="sortOrder" xsi:type="string">25</item>
                                    <item name="config" xsi:type="array">
                                        <item name="title" xsi:type="string" translate="true">Pay by bank discount</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
