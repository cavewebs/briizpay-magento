<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="briizpay" translate="label comment" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>BriizPay - Pay by bank</label>
                <comment><![CDATA[UK Open Banking payments at checkout. Your customer approves in their own banking app and the money goes straight to your bank account. Connect your store in the BriizPay dashboard under Integrations, Magento, to get the API key and webhook signing secret below.]]></comment>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                    <comment>What the customer sees at checkout.</comment>
                </field>
                <field id="description" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Description</label>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>From BriizPay. A key beginning bzp_sk_test_ uses the test environment and moves no real money.</comment>
                </field>
                <field id="webhook_secret" translate="label" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Webhook signing secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="webhook_url" translate="label" type="text" sortOrder="55" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Webhook URL</label>
                    <frontend_model>BriizPay\PayByBank\Block\Adminhtml\System\Config\WebhookUrl</frontend_model>
                </field>
                <field id="discount_enabled" translate="label comment" type="select" sortOrder="56" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Offer a discount for paying by bank</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>A saving the customer can see is the reason to choose their bank over a card. It shows as its own line, Pay by bank discount, once they choose this method, and comes off again if they choose another.</comment>
                </field>
                <field id="discount_type" translate="label" type="select" sortOrder="57" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Discount type</label>
                    <source_model>BriizPay\PayByBank\Model\Config\Source\DiscountType</source_model>
                    <depends>
                        <field id="discount_enabled">1</field>
                    </depends>
                </field>
                <field id="discount_amount" translate="label comment" type="text" sortOrder="58" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Discount amount</label>
                    <backend_model>BriizPay\PayByBank\Model\Config\Backend\DiscountAmount</backend_model>
                    <frontend_class>validate-zero-or-greater</frontend_class>
                    <comment>As a percentage, 1 means 1% off. As a fixed amount, 1 means £1.00 off. Applied to the items total after coupons, with tax, before shipping, and never more than the items themselves.</comment>
                    <depends>
                        <field id="discount_enabled">1</field>
                    </depends>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from applicable countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from specific countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort order</label>
                    <frontend_class>validate-number</frontend_class>
                </field>
            </group>
        </section>
    </system>
</config>
