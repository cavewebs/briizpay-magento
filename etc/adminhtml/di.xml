<?xml version="1.0"?>
<!--
    The admin notification that BriizPay is installed but not connected.
    See Model/Adminhtml/System/Message/NotConfigured.php for why it exists.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="briizpayNotConfigured" xsi:type="string">BriizPay\PayByBank\Model\Adminhtml\System\Message\NotConfigured</item>
            </argument>
        </arguments>
    </type>
</config>
