<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <!-- The saving paying by bank would give this basket, whichever method is
         chosen, so the checkout can say "and save £1.20" next to the method
         before the customer picks it. Set by Plugin/Quote/AddDiscountOffer. -->
    <extension_attributes for="Magento\Quote\Api\Data\TotalsInterface">
        <attribute code="briizpay_discount_offer" type="float"/>
    </extension_attributes>
</config>
