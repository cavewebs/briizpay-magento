<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="order_cancel_after">
        <observer name="briizpay_cancel_payment_request" instance="BriizPay\PayByBank\Observer\CancelPaymentRequest"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="briizpay_copy_discount_to_order" instance="BriizPay\PayByBank\Observer\CopyDiscountToOrder"/>
    </event>
    <!--
      A store refunding through its own credit memo screen, which is the only
      refund this module offers. save_after rather than register_before: the
      memo exists and its totals are final by then, so the amount reported is
      the amount the merchant actually credited.
    -->
    <event name="sales_order_creditmemo_save_after">
        <observer name="briizpay_report_credit_memo" instance="BriizPay\PayByBank\Observer\ReportCreditMemo"/>
    </event>
</config>
