<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The payment method, built from the Payment Gateway pieces rather than a
         subclass of the deprecated AbstractMethod. -->
    <virtualType name="BriizPayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">BriizPay\PayByBank\Model\Config::METHOD_CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">BriizPayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">BriizPayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">BriizPayCommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayGatewayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">BriizPay\PayByBank\Model\Config::METHOD_CODE</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">BriizPayGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">BriizPayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">BriizPayGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="availability" xsi:type="string">BriizPay\PayByBank\Gateway\Validator\AvailabilityValidator</item>
                <item name="country" xsi:type="string">BriizPayCountryValidator</item>
                <item name="currency" xsi:type="string">BriizPay\PayByBank\Gateway\Validator\CurrencyValidator</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">BriizPay\PayByBank\Gateway\Command\InitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>
</config>
