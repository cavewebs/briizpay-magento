<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The payment method, built from the Payment Gateway pieces rather than a
         subclass of the deprecated AbstractMethod. -->
    <virtualType name="BriizPayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">BriizPay\PayByBank\Model\Config::METHOD_CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">BriizPayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">BriizPayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">BriizPayCommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayGatewayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">BriizPay\PayByBank\Model\Config::METHOD_CODE</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">BriizPayGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">BriizPayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">BriizPayGatewayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="availability" xsi:type="string">BriizPay\PayByBank\Gateway\Validator\AvailabilityValidator</item>
                <item name="country" xsi:type="string">BriizPayCountryValidator</item>
                <item name="currency" xsi:type="string">BriizPay\PayByBank\Gateway\Validator\CurrencyValidator</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BriizPayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">BriizPay\PayByBank\Gateway\Command\InitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- The pay by bank discount can only reach an order its method earns it on:
         see the plugin for why this is checked at submit and not trusted to the
         checkout. -->
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="briizpay_recollect_stale_discount" type="BriizPay\PayByBank\Plugin\Quote\RecollectStaleDiscount"/>
    </type>

    <type name="Magento\Quote\Api\CartTotalRepositoryInterface">
        <plugin name="briizpay_add_discount_offer" type="BriizPay\PayByBank\Plugin\Quote\AddDiscountOffer"/>
    </type>

    <!-- Arithmetic helpers and the API client as interceptable services. -->
    <preference for="BriizPay\PayByBank\Api\ClientInterface" type="BriizPay\PayByBank\Model\Api\Client"/>
    <preference for="BriizPay\PayByBank\Api\MoneyInterface" type="BriizPay\PayByBank\Model\Money"/>
    <preference for="BriizPay\PayByBank\Api\DiscountInterface" type="BriizPay\PayByBank\Model\Discount"/>
    <preference for="BriizPay\PayByBank\Api\LineItemsInterface" type="BriizPay\PayByBank\Model\LineItems"/>
    <preference for="BriizPay\PayByBank\Api\DocumentItemsInterface" type="BriizPay\PayByBank\Model\Total\DocumentItems"/>
    <preference for="BriizPay\PayByBank\Api\DiscountCalculatorInterface" type="BriizPay\PayByBank\Model\DiscountCalculator"/>

    <!-- PHP SDK: Magento Curl as PSR-18 with a 20s timeout, and a small PSR-17
         factory because Magento does not ship one of its own. -->
    <preference for="BriizPay\Sdk\Contract\WebhookVerifierInterface" type="BriizPay\Sdk\Webhook\WebhookSignature"/>
    <type name="BriizPay\PayByBank\Model\Http\CurlClient">
        <arguments>
            <argument name="timeout" xsi:type="number">20</argument>
        </arguments>
    </type>
    <type name="BriizPay\PayByBank\Model\Api\SdkClientFactory">
        <arguments>
            <argument name="httpClient" xsi:type="object">BriizPay\PayByBank\Model\Http\CurlClient</argument>
            <argument name="requestFactory" xsi:type="object">BriizPay\PayByBank\Model\Http\Psr17Factory</argument>
            <argument name="streamFactory" xsi:type="object">BriizPay\PayByBank\Model\Http\Psr17Factory</argument>
        </arguments>
    </type>
</config>
