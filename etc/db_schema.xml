<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="briizpay_webhook_event" resource="default" engine="innodb" comment="BriizPay webhook events already applied">
        <column xsi:type="varchar" name="event_id" nullable="false" length="64" comment="Event id from BriizPay"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="When it was applied"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
        </constraint>
        <index referenceId="BRIIZPAY_WEBHOOK_EVENT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <!-- The pay by bank discount, negative like discount_amount, in the order
         currency and the base currency. On quote_address because the checkout's
         totals are read back from the address's saved data; on each sales
         document so it is shown, invoiced and refunded as it was given. -->
    <table name="quote" resource="checkout">
        <column xsi:type="decimal" name="briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount"/>
        <column xsi:type="decimal" name="base_briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount in base currency"/>
    </table>
    <table name="quote_address" resource="checkout">
        <column xsi:type="decimal" name="briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount"/>
        <column xsi:type="decimal" name="base_briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount in base currency"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="decimal" name="briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount"/>
        <column xsi:type="decimal" name="base_briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount in base currency"/>
    </table>
    <table name="sales_invoice" resource="sales">
        <column xsi:type="decimal" name="briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount"/>
        <column xsi:type="decimal" name="base_briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount in base currency"/>
    </table>
    <table name="sales_creditmemo" resource="sales">
        <column xsi:type="decimal" name="briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount"/>
        <column xsi:type="decimal" name="base_briizpay_discount_amount" scale="4" precision="20" unsigned="false" nullable="true" default="0" comment="Pay by bank discount in base currency"/>
    </table>
</schema>
